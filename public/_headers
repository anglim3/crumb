# Headers for the hosted editor. Vite copies this file into dist/ for Workers static assets.
# style-src keeps 'unsafe-inline' because the board and color swatches set style attributes.
# img-src allows data images and the blob URLs used for SVG and PNG export.
# Fonts are self-hosted, so font-src does not name a third-party host.
# The manifest, icons, and og.png are same-origin files, covered by default-src and img-src.
# Share compression uses CompressionStream in the page and does not add a connect target.
#
# Workers match _headers against the request URL. The SPA fallback serves the
# /index.html body for an unknown path, but it does not apply the / or
# /index.html rules. Those paths only match /*, so Cache-Control on /* is
# `public, max-age=0, must-revalidate, no-transform`. That covers /, the
# /index.html redirect, and the fallback HTML. A narrower Cache-Control is
# comma-joined onto that value; `! Cache-Control` removes it first.
# Static rules detach it and set `public, max-age=0, must-revalidate` without
# no-transform, so the edge can compress them. Do not set Cache-Control again
# on / or /index.html. A missing URL under /assets/* is still the SPA shell
# and uses the asset value.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/favicon-32.png
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/og.png
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/site.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
